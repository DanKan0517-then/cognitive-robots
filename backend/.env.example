# Copy to .env and fill in only what you actually have. Nothing here is
# required — the system runs fully offline with a deterministic reasoning
# fallback when ANTHROPIC_API_KEY is unset.

# Optional. If set, agents route reasoning/critique/planning prompts through
# the Claude API instead of the built-in deterministic fallback. Leave unset
# to run with zero paid API dependency (this is the default, tested path).
ANTHROPIC_API_KEY=

# Optional. Overrides where the SQLite database file is written.
# Defaults to ./cognitive_robots.db in the backend/ directory.
COGROBOT_DB_PATH=
